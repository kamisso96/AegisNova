---
import ContactInfo from './ContactInfo.astro';
import ContactForm from '../react/ContactForm.jsx';
---

<section id="contact" class="contact-section section">
  <div class="container">
    <div class="section-heading">
      <h2 class="section-title">Contactez-nous</h2>
      <p class="section-subtitle">Nous sommes à votre écoute</p>
    </div>
    <div class="contact-grid">
      <ContactInfo />
      <ContactForm client:visible />
    </div>
  </div>
</section>

<style>
  .contact-section {
    background: var(--light);
    padding: 80px 0;
  }

  .section-heading {
    text-align: center;
    margin-bottom: 50px;
  }

  /* Titre de section identique aux précédentes */
  .contact-section .section-title {
    font-size: 3rem;
    font-weight: 700;
    color: var(--primary-dark);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }

  /* Description de section identique aux précédentes */
  .contact-section .section-subtitle {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--gray);
    letter-spacing: 0.5px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: stretch;
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>