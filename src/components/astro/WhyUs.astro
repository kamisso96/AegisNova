---
import { whyUs } from '../../data/whyUs';
import Icon from './Icon.astro';
---

<section id="pourquoi-nous" class="why-us-section section">
  <div class="container">
    <div class="section-heading">
      <h2 class="section-title">Pourquoi Nous Choisir ?</h2>
      <p class="section-subtitle">Les raisons qui font d'AegisNova votre partenaire de confiance</p>
    </div>
    <div class="why-us-grid">
      {whyUs.map((item) => (
        <div class="why-card">
          <div class="why-icon">
            <Icon name={item.icon} size={36} />
          </div>
          <h3 class="why-title">{item.title}</h3>
          <p class="why-description">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-us-section {
    background: var(--white);
    background-image: 
      radial-gradient(circle at 20% 30%, rgba(242,190,161,0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(174,129,135,0.15) 0%, transparent 50%);
  }

  .section-heading {
    text-align: center;
    margin-bottom: 50px;
  }

  /* Titre de section identique aux sections précédentes */
  .why-us-section .section-title {
    font-size: 3rem;
    font-weight: 700;
    color: var(--primary-dark);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }

  /* Description de section identique aux sections précédentes */
  .why-us-section .section-subtitle {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--gray);
    letter-spacing: 0.5px;
  }

  .why-us-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;
  }

  .why-card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 20px;
    padding: 40px 30px;
    text-align: center;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    flex: 0 0 100%;
    max-width: 350px;
  }

  .why-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
    background: rgba(255, 255, 255, 0.9);
  }

  .why-icon {
    width: 70px;
    height: 70px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: var(--primary-gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    transition: transform 0.4s ease;
  }

  .why-card:hover .why-icon {
    transform: rotate(360deg) scale(1.05);
  }

  .why-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 15px;
    color: var(--dark);
  }

  .why-description {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--gray);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .why-card {
      flex: 0 0 calc(50% - 15px);
      max-width: calc(50% - 15px);
    }
  }

  @media (min-width: 992px) {
    .why-card {
      flex: 0 0 calc(33.333% - 20px);
      max-width: calc(33.333% - 20px);
    }
  }
</style>