---
import BaseLayout from '../layouts/Layout.astro';
---

<BaseLayout title="Page introuvable - AegisNova" description="La page que vous recherchez n'existe pas.">
  <div class="error-page">
    <div class="error-content">
      <h1 class="error-code">404</h1>
      <h2 class="error-title">Oups ! Page introuvable</h2>
      <p class="error-message">
        Désolé, la page que vous recherchez semble avoir disparu ou n'a jamais existé.
      </p>
      <div class="error-actions">
        <a href="/" class="error-btn error-btn-primary">Retour à l'accueil</a>
        <a href="#contact" class="error-btn error-btn-secondary">Nous contacter</a>
      </div>
    </div>
    <div class="error-decoration" aria-hidden="true">
      <span class="circle circle-1"></span>
      <span class="circle circle-2"></span>
      <span class="circle circle-3"></span>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    background: var(--white);
    overflow: hidden;
    padding: 100px 20px;
  }

  .error-content {
    text-align: center;
    z-index: 2;
    max-width: 600px;
  }

  .error-code {
    font-size: 8rem;
    font-weight: 700;
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin-bottom: 10px;
  }

  .error-title {
    font-size: 2rem;
    font-weight: 600;
    color: var(--dark);
    margin-bottom: 15px;
  }

  .error-message {
    font-size: 1.1rem;
    color: var(--gray);
    margin-bottom: 30px;
  }

  .error-actions {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .error-btn {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 30px;
    font-weight: 600;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  .error-btn-primary {
    background: var(--primary-gradient);
    color: var(--white);
    border: none;
  }

  .error-btn-primary::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: var(--dark);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.5s ease, height 0.5s ease;
    z-index: -1;
  }

  .error-btn-primary:hover {
    color: var(--white);
  }

  .error-btn-primary:hover::before {
    width: 300px;
    height: 300px;
  }

  .error-btn-secondary {
    background: var(--white);
    color: var(--primary-dark);
    border: 2px solid var(--primary);
  }

  .error-btn-secondary:hover {
    background: var(--primary-lighter);
    border-color: var(--primary-dark);
  }

  /* Cercles décoratifs */
  .error-decoration {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .circle {
    position: absolute;
    border-radius: 50%;
    background: var(--primary-lighter);
    opacity: 0.3;
  }

  .circle-1 {
    width: 300px;
    height: 300px;
    top: -80px;
    right: -80px;
  }

  .circle-2 {
    width: 200px;
    height: 200px;
    bottom: -50px;
    left: -50px;
  }

  .circle-3 {
    width: 100px;
    height: 100px;
    top: 40%;
    left: 20%;
  }

  @media (max-width: 576px) {
    .error-code {
      font-size: 5rem;
    }
    .error-title {
      font-size: 1.5rem;
    }
    .error-actions {
      flex-direction: column;
      align-items: center;
    }
  }
</style>